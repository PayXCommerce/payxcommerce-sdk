<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="payxcommerce_webhook_event" resource="default" engine="innodb" comment="PayXCommerce Webhook Event Claims">
        <column xsi:type="varchar" name="claim_key" nullable="false" length="64" comment="Atomic Claim Key"/>
        <column xsi:type="varchar" name="event_id" nullable="false" length="191" comment="PayXCommerce Event ID"/>
        <column xsi:type="bigint" name="order_id" unsigned="true" nullable="false" comment="Magento Order ID"/>
        <column xsi:type="smallint" name="store_id" unsigned="true" nullable="false" comment="Magento Store ID"/>
        <column xsi:type="varchar" name="payload_hash" nullable="false" length="64" comment="Raw Payload SHA256"/>
        <column xsi:type="varchar" name="processing_status" nullable="false" length="16" comment="Processing Status"/>
        <column xsi:type="varchar" name="claim_token" nullable="false" length="64" comment="Claim Token"/>
        <column xsi:type="text" name="error_message" nullable="true" comment="Last Safe Error"/>
        <column xsi:type="timestamp" name="claimed_at" nullable="false" default="CURRENT_TIMESTAMP" on_update="false" comment="Claimed At"/>
        <column xsi:type="timestamp" name="processed_at" nullable="true" on_update="false" comment="Processed At"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="claim_key"/>
        </constraint>
        <index referenceId="PAYXCOMMERCE_WEBHOOK_EVENT_EVENT_ID" indexType="btree">
            <column name="event_id"/>
        </index>
        <index referenceId="PAYXCOMMERCE_WEBHOOK_EVENT_ORDER_STORE" indexType="btree">
            <column name="order_id"/>
            <column name="store_id"/>
        </index>
    </table>
</schema>
